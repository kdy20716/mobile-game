    \uC2DC \uD654\uBA74\uC758 \uBAA8\uB4E0 \uBE14\uB85D \uD3ED\uD30C + \uBFB0\uB85C\uB871
    \uB9C8\uBC95 \uC5F0\uCD9C!\n\u2022 \uAE68\uB057\uD55C \uBE48 \uD310\uC5D0\uC11C
