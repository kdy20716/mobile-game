  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>[\uC548\uB0B4 \uC0AC\uD56D]</b>\n\u2022 \uC2A4\uD398\uC15C \uB9D0\uB791\uC774
    \uC18C\uD658 \uD655\uB960\uC774 <b>1.0%</b>\uB85C \uB300\uD3ED \uC99D\uAC00 \uC801\uC6A9\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\u2022
    \uC2A4\uD398\uC15C \uB9D0\uB791\uC774\uB97C \uC911\uBCF5 \uD68D\uB4DD \uC2DC
    <b>\uC2A4\uD398\uC15C \uC870\uAC01 60\uAC1C</b>\uB85C \uC9C0\uAE09\uB418\uC5B4
    \uC989\uC2DC 1\uD68C \uB3CC\uD30C\uAC00 \uAC00\uB2A5\uD569\uB2C8\uB2E4.\n\u2022
    \uC77C\uBC18/\uD76C\uADC0 \uB9D0\uB791\uC774\uB294 \uC870\uAC01 1\uAC1C \uB610\uB294
    5\uAC1C\uB85C \uB4F1\uC7A5\uD558\uBA70, <b>60\uAC1C \uC218\uC9D1 \uC2DC \uCE90\uB9AD\uD130\uB97C
    \uD68D\uB4DD</b>\uD569\uB2C8\uB2E4.\n\u2022 \uC18C\uD658 \uD655\uB960\uC740 \uB3C5\uB9BD
    \uC2DC\uD589\uC73C\uB85C \uC801\uC6A9\uB418\uBA70, \uAD6C\uB9E4 \uC804 \uD655\uB960
    \uC815\uBCF4\uB97C \uC0C1\uC2DC \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  m_isRightToLeft: 0
